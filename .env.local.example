# ---------------------------------------------------------------- Supabase
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --------------------------------------------------------------- Assistant
# Set at least one. Every provider below has a free tier and no card needed.
# Whichever keys are present appear in the model menu inside the chat box.

# https://console.groq.com/keys — fast, generous free tier
GROQ_API_KEY=
# https://openrouter.ai/keys — one key, many free models, routes to others
OPENROUTER_API_KEY=
# https://cloud.cerebras.ai — 1M tokens a day free
CEREBRAS_API_KEY=
# https://console.mistral.ai/api-keys — free tier, no card
MISTRAL_API_KEY=
# https://aistudio.google.com/apikey — the one that reads images best
GEMINI_API_KEY=
# Optional, paid: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Models are chosen in the app, so these are rarely needed.
# ASSISTANT_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/auto
# CEREBRAS_MODEL=llama-3.3-70b
# MISTRAL_MODEL=mistral-small-latest
