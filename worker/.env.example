# ---------------------------------------------------------------- Telegram
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Produced by `npm run login`. Treat it like a password: it IS your account.
TELEGRAM_SESSION=

# ---------------------------------------------------------------- Supabase
# Project Settings -> API. The SECRET key, not the publishable one.
# It bypasses row level security, so it must never reach a browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Which teacher this worker sends for.
# Find it in Supabase -> Authentication -> Users -> your user's UID.
TEACHER_ID=

# ------------------------------------------------------------------ tuning
# How often to look for due messages, in seconds.
POLL_SECONDS=20
# Set to 1 to log what it would send without sending anything.
DRY_RUN=0
