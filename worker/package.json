{
  "name": "labbay-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sends Labbay's queued messages from the teacher's own Telegram account.",
  "scripts": {
    "login": "node --env-file-if-exists=.env login.mjs",
