    "dry-run": "node --env-file-if-exists=.env index.mjs --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "input": "^1.0.1",
    "telegram": "^2.26.22"
  },
  "engines": {
    "node": ">=22"
  }
}